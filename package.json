{
  "name": "tagro-os",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "dev:staging": "wrangler dev --env staging",
    "preview:my-space": "node scripts/preview-my-space.mjs",
    "verify:intake": "node scripts/verify-intake.mjs",
    "verify:isolation": "node scripts/verify-app-isolation.mjs",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "verify:parts": "node scripts/verify-parts-workflow.mjs",
    "deploy": "wrangler deploy --env=\"\" --strict",
    "deploy:staging": "wrangler deploy --env staging --strict",
    "deploy:dry-run": "wrangler deploy --env=\"\" --dry-run --strict",
    "deploy:staging:dry-run": "wrangler deploy --env staging --dry-run --strict",
    "db:migrate:local": "wrangler d1 migrations apply tagro-os --local",
    "db:migrate:production": "wrangler d1 migrations apply tagro-os --env=\"\" --remote",
    "db:migrate:staging": "wrangler d1 migrations apply tagro-os-staging --env staging --remote"
  },
  "devDependencies": {
    "wrangler": "^4.24.3"
  },
  "type": "module",
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
